# Hosted Studio. Copy to .env.production.local (gitignored). Do not commit the real file.
# next build / next start and ./scripts/build-and-host.sh load .env.production.local
# ahead of .env.local, so a local SQLite file does not override this.
#
# Use a separate database. Do not point DATABASE_URL at the student database
# named teachcode. Studio content tables reference profiles.id as uuid.

DATABASE_MODE=postgres
DATABASE_URL=postgresql://teachcode:replace-me@127.0.0.1:5432/teachcode_studio
APP_URL=https://codewithAI.hku.hk/studio
ALLOWED_CORS_ORIGINS=https://codewithAI.hku.hk
STUDIO_BASE_PATH=/studio
# Shared with the student app server. Never NEXT_PUBLIC_* or a browser header from learners.
STUDIO_MANAGEMENT_SECRET=replace-with-a-long-random-string
# Student app API on this machine. Used to accept an existing TeachCode session.
# TEACHCODE_API_ORIGIN=http://127.0.0.1:8002
# Optional. When omitted, Back to TeachCode is APP_URL with /studio removed, plus /learn.
# TEACHCODE_PUBLIC_URL=https://codewithAI.hku.hk

# Same OpenRouter account as the student app. Server-only. Never NEXT_PUBLIC_*.
OPENROUTER_API_KEY=sk-or-v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_REASONING_ENABLED=false
