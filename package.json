{
  "name": "teachcode-content-studio",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:init:sqlite": "node scripts/init-local-sqlite.mjs",
    "predev": "tsx scripts/check-startup.ts",
    "prestart": "tsx scripts/check-startup.ts",
    "typecheck": "tsc --noEmit",
    "db:reset:sqlite": "node scripts/reset-local-sqlite.mjs",
    "test:e2e": "playwright test",
    "test:postgres": "TEST_POSTGRES=1 vitest run tests/postgres.test.ts",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs *.json docs README.md .github"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "next": "^15.1.0",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
